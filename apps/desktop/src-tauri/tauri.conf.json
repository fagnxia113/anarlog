{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知记",
  "mainBinaryName": "zhiji",
  "identifier": "com.zhiji.meetnote",
  "build": {
    "beforeDevCommand": "pnpm -F @zhiji/desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F @zhiji/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "知记 - 个人会议纪要与笔记本",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "publisher": "知记",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
