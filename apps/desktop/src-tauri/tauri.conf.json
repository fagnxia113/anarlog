{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zhnote Dev",
  "mainBinaryName": "zhnote-dev",
  "identifier": "com.zhnote.dev",
  "build": {
    "beforeDevCommand": "pnpm -F desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F desktop build",
    "beforeBundleCommand": "node ./src-tauri/scripts/before-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "publisher": "zhnote",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "externalBin": [],
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.ico"
    ],
    "resources": {
      "resources/vcrt/*": ".",
      "resources/notification-icons": "notification-icons"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "zhnote-dev",
          "zhnote"
        ]
      }
    },
    "updater": {
      "active": false
    }
  }
}
