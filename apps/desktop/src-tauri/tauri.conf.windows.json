{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "windows": {
      "staticVCRuntime": true
    }
  },
  "bundle": {
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
