{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zhnote",
  "mainBinaryName": "zhnote",
  "identifier": "com.zhnote.stable",
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["zhnote", "anarlog"] }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://desktop2.hyprnote.com/update/{{target}}-{{arch}}/{{current_version}}?channel=stable"
      ]
    }
  }
}
