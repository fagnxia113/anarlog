{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhnote",
  "version": "0.1.0",
  "mainBinaryName": "zhnote",
  "identifier": "com.zhnote.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1530",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerLanguages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
